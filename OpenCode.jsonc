{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "deny",
    "bash": "ask",
    "webfetch": "allow"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-12e57e06-ac08-4155-a80d-6705fed1ad77"
      },
      "enabled": true
    }
  },
  "provider": {
    "kiro-proxy": {
      "npm": "@ai-sdk/anthropic",
      "name": "KiroProxy",
      "options": {
        "baseURL": "http://localhost:8080/v1"
      },
      "models": {
        "claude-sonnet-4.5": {
          "limit": {
            "context": 180000,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "claude-sonnet-4": {
          "limit": {
            "context": 180000,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "claude-haiku-4.5": {
          "limit": {
            "context": 180000,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "claude-opus-4.5": {
          "limit": {
            "context": 180000,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "auto": {
          "limit": {
            "context": 180000,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "claude-sonnet-4-thinking": {
          "limit": {
            "context": 180000,
            "output": 16000
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "claude-opus-4.5-thinking": {
          "limit": {
            "context": 180000,
            "output": 16000
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "claude-opus-4-5-20251101": {
          "limit": {
            "context": 180000,
            "output": 16000
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    },
    "duojie": {
      "npm": "@ai-sdk/anthropic",
      "name": "DuoJie",
      "options": {
        "baseURL": "https://api.duojie.games/v1"
      },
      "models": {
        "claude-opus-4-5-20251101": {
          "limit": {
            "context": 180000,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "claude-opus-4-5-think": {
          "limit": {
            "context": 180000,
            "output": 16000
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "gemini-claude-opus-4-5-thinking": {
          "limit": {
            "context": 180000,
            "output": 16000
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "gemini-3-pro-preview": {
          "limit": {
            "context": 900000,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "glm-4.7": {
          "limit": {
            "context": 115200,
            "output": 4096
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "gpt-5.2": {
          "limit": {
            "context": 115200,
            "output": 16384
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "gpt-5.2-codex": {
          "limit": {
            "context": 115200,
            "output": 16384
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
